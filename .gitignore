cat > .gitignore <<'EOF'
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.venv/
venv/

# macOS
.DS_Store

# IDE
.idea/

# Build/Artifacts
dist/
build/

# Project-specific
dataset/
clusters/
*.log
EOF

git add .gitignore
git rm -r --cached .venv  # stop tracking the already-added venv
git commit -m "chore: ignore venv, caches, dataset; stop tracking .venv"
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
config.bat
node_modules
